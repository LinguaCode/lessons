print("How old are you?")
age = input()
print("How tall are you, in centimeters?")
height = input()
tall_enough = height >= 130
if age >= 8 and tall_enough
    print("You can ride the roller coaster!")
else if not tall_enough
    print("You need to grow a little more.")
else
    print("Come back when you are 8.")
if age < 3 or age > 70
    print("And your ticket is free.")
